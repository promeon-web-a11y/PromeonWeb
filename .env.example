# ==============================================================
#  お問い合わせフォーム用の環境変数（サンプル）
# --------------------------------------------------------------
#  このファイルは「見本」です。実際の値は書かず、GitHub に置いたままで問題ありません。
#
#  使い方：
#   1) このファイルをコピーして「.env」という名前で保存する
#   2) 下の各値を、自分が取得した本物の値に置き換える
#   3) .env は .gitignore 済みなので GitHub には push されません
#
#  本番（Vercel）では、この3つを Vercel の管理画面で登録します。
#  （Project → Settings → Environment Variables）
# ==============================================================

# Resend（https://resend.com）で発行する API キー。「re_」で始まる文字列。
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 問い合わせメールの届け先。ご自身の受信できるメールアドレス。
CONTACT_TO_EMAIL=satokazu.promeon@gmail.com

# 差出人アドレス（任意）。
#  独自ドメインを Resend で認証するまでは、下のテスト用アドレスのままにしてください。
#  テスト用アドレスの場合、メールは CONTACT_TO_EMAIL（Resend 登録時のアドレス）にのみ届きます。
CONTACT_FROM_EMAIL=Promeon Web <onboarding@resend.dev>
